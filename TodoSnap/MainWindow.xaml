<Window x:Class="TodoSnap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TodoSnap" Width="380" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" AllowDrop="True"
        FontSize="14" FontFamily="Segoe UI, Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Drop="Window_Drop" DragEnter="Window_DragEnter">

    <Grid x:Name="Root" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <!-- Background layer: only this fades with the transparency slider, so text
             and controls above it always stay fully opaque. -->
        <Border x:Name="BgLayer" CornerRadius="12"
                Background="{DynamicResource Brush.WindowBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"/>

        <Border CornerRadius="12" Background="Transparent" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0: title bar -->
                    <RowDefinition Height="Auto"/>  <!-- 1: preview -->
                    <RowDefinition Height="*"/>     <!-- 2: editor -->
                    <RowDefinition Height="Auto"/>  <!-- 3: actions -->
                </Grid.RowDefinitions>

                <!-- Title row: brand + AI status dot on left, settings/hide on right -->
                <Grid Grid.Row="0" Margin="0,0,0,10" Height="24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <TextBlock Text="TodoSnap"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <Ellipse x:Name="AiStatusDot" Width="8" Height="8"
                                 Margin="8,0,0,0" VerticalAlignment="Center"
                                 Fill="#9E9E9E" ToolTip="AI 未配置"/>
                        <TextBlock x:Name="AiStatusLabel" Text="离线 OCR"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="⚙" Width="24" Height="24"
                                Style="{StaticResource FlatButton}" Padding="0" FontSize="13"
                                Click="Settings_Click" ToolTip="设置"/>
                        <Button Content="✕" Width="24" Height="24" Margin="4,0,0,0"
                                Style="{StaticResource FlatButton}" Padding="0" FontSize="12"
                                Click="Hide_Click" ToolTip="隐藏到托盘"/>
                    </StackPanel>
                </Grid>

                <!-- Preview -->
                <Border Grid.Row="1" Height="70" CornerRadius="8"
                        Background="{DynamicResource Brush.Control}"
                        Margin="0,0,0,8">
                    <Grid>
                        <TextBlock x:Name="TxtHint" Text="在此粘贴截图 (Ctrl+V)"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="ImgPreview" Stretch="Uniform" Visibility="Collapsed" Margin="4"/>
                    </Grid>
                </Border>

                <!-- Editor + status overlay -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <TextBox x:Name="TxtDesc"
                             Background="{DynamicResource Brush.InputBg}"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             CaretBrush="{DynamicResource Brush.TextPrimary}"
                             BorderThickness="0" Padding="8" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"/>
                    <TextBlock x:Name="TxtStatus" Text="分析中…" Foreground="#FFD54F"
                               Background="#88000000" Padding="8,4"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               Margin="6" Visibility="Collapsed"/>
                </Grid>

                <!-- Actions -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Click="Cancel_Click"
                            Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnAdd" Content="添加待办" IsDefault="True"
                            Click="Add_Click" Style="{StaticResource AccentButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
