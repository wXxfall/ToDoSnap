<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Light theme tokens ====================================
         Same keys as Dark.xaml with a light-surface / dark-ink palette.
         Surface/border brushes use a black alpha so they read correctly on
         the light background; the accent green is kept for brand continuity. -->

    <SolidColorBrush x:Key="Brush.WindowBg"      Color="#F4F5F7"/>
    <SolidColorBrush x:Key="Brush.PanelBg"       Color="#FBFBFD"/>

    <SolidColorBrush x:Key="Brush.TextPrimary"   Color="#DD000000"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#99000000"/>
    <SolidColorBrush x:Key="Brush.TextMuted"     Color="#66000000"/>

    <SolidColorBrush x:Key="Brush.Control"       Color="#11000000"/>
    <SolidColorBrush x:Key="Brush.ControlHover"  Color="#1F000000"/>
    <SolidColorBrush x:Key="Brush.Border"        Color="#22000000"/>
    <SolidColorBrush x:Key="Brush.InputBg"       Color="#0F000000"/>

    <SolidColorBrush x:Key="Brush.Accent"        Color="#3D7D32"/>
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#4CAF50"/>

</ResourceDictionary>
