<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Dark theme tokens =====================================
         Switched in at runtime by Helpers/ThemeManager. Every color used by
         the windows is a DynamicResource pointing at one of these keys, so
         swapping this dictionary for Light.xaml re-skins the whole app live.
         Background brushes (WindowBg/PanelBg) are opaque here; the actual
         translucency is applied per-window on a dedicated background layer
         (see BackgroundOpacity), so text never fades with it. -->

    <SolidColorBrush x:Key="Brush.WindowBg"      Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Brush.PanelBg"       Color="#222222"/>

    <SolidColorBrush x:Key="Brush.TextPrimary"   Color="#EEFFFFFF"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="Brush.TextMuted"     Color="#66FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Control"       Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ControlHover"  Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Border"        Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Brush.InputBg"       Color="#22000000"/>

    <SolidColorBrush x:Key="Brush.Accent"        Color="#3D7D32"/>
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#4CAF50"/>

</ResourceDictionary>
